# CasePilot 环境变量
# docker compose 部署时会自动读取此文件

# ── Anthropic / DeepSeek ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=replace_with_your_model_api_key
ANTHROPIC_MODEL=replace_with_a_model_id_supported_by_your_provider
# 官方服务留空；兼容服务填写其 Anthropic Messages 地址。
ANTHROPIC_BASE_URL=

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=replace_with_a_long_random_url_safe_password
# docker compose 内部地址（容器间通信）
# Compose 会基于 REDIS_PASSWORD 自动设置容器内的 REDIS_URL。
# 宿主机原生运行时自行设置，例如 redis://:your_password@localhost:6379/0

# ── ChromaDB（情景记忆 + 用户画像）─────────────────────────────────────────────
# docker compose 内部地址（连接独立 ChromaDB 服务）
CHROMA_HOST=chromadb
CHROMA_PORT=8000
# 降级用本地路径（ChromaDB 服务不可用时自动切换）
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
MONITOR_INTERVAL=10
ALERT_WEBHOOK_URL=

# ── 标准 MCP ─────────────────────────────────────────────────────────────────
# 默认连接无需 Key 的 Microsoft Learn 公开文档 MCP；设 false 可关闭外部连接。
MCP_EXTERNAL_ENABLED=true
# 不填时读取当前项目 config/mcp_servers.json，Docker 内默认路径同样可用。
# MCP_SERVERS_CONFIG=/app/config/mcp_servers.json
# 通过自定义域名访问 /mcp/ 时，将域名加入允许列表（逗号分隔）。
# MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,casepilot,casepilot:*,casepilot-python,casepilot-python:*,your-domain.example
# MCP_ALLOWED_ORIGINS=https://your-domain.example,http://localhost,http://localhost:*

# 本地默认 development；对外部署设置 production 并配置独立随机 API Token（不是模型 Key）。
CASEPILOT_ENV=development
# CASEPILOT_API_TOKENS={"至少24位随机Token":{"user_id":"u1","role":"user"},"另一管理员Token至少24位":{"user_id":"admin","role":"admin"}}

# 三路意图识别：有硅基流动 Key 自动启用当前免费版 BAAI/bge-m3；无 Key 使用本地 n-gram。
# 不使用收费的 Pro/BAAI/bge-m3，不与 ANTHROPIC_API_KEY 共用。
INTENT_EMBEDDING_PROVIDER=auto
SILICONFLOW_API_KEY=
